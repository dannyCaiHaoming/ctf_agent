+// No model calls. Product launcher/plugin/C/OpenCode use a loopback scripted provider.
+// Wrappers below only observe the host job lifecycle; they do not send completion notifications.
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { mkdtemp, mkdir, readFile, writeFile, readdir } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import type { OpencodeClient } from '@opencode-ai/sdk/v2';
+import { launch } from '../../apps/launcher/src/launch.js';
+import { JobManager } from '../../apps/launcher/src/job-tools.js';
+
+const evidence = resolve('docs/gates/g-solver-verification-20261023/decision-long-job/runtime', process.argv[2] ?? 'first');
+await mkdir(evidence, { recursive: true });
+const scenarios = (process.argv[3] ? [process.argv[3]] : ['success', 'timeout', 'abort']) as Array<'success' | 'timeout' | 'abort'>;
+const originalRun = JobManager.prototype.run;
+for (const scenario of scenarios) {
+  const out = join(evidence, scenario); await mkdir(out, { recursive: true });
+  const root = await mkdtemp(join(tmpdir(), 'gdec-long-job-'));
+  const events: Array<Record<string, unknown>> = []; const provider: Array<Record<string, unknown>> = [];
+  let client: OpencodeClient; let rootID = ''; let childID = ''; let jobID = '';
+  let parentStep = 0; let childStep = 0; let seq = 0; let observedError: string | undefined;
+  let endedAt = 0; let initialAt = 0; let initialState = ''; let taskDuring: unknown;
+  const abortEvents = new AbortController();
+  let observer: Promise<void> = Promise.resolve();
+  let result: Awaited<ReturnType<typeof launch>> | undefined; let failure: string | undefined;
+  const wait = (ms: number) => new Promise<void>(r => setTimeout(r, ms));
+  const messages = async (id: string) => (await client.session.messages({ sessionID: id }, { throwOnError: true })).data ?? [];
+  const parentTask = async () => (await messages(rootID)).flatMap(m => m.parts).find(p => p.type === 'tool' && p.tool === 'task');
+  JobManager.prototype.run = async function(binding, args, operation) {
+    events.push({ at: Date.now(), event: 'job.start', sessionID: binding.sessionId, args });
+    const initial = await originalRun.call(this, binding, args, operation);
+    childID = binding.sessionId; jobID = initial.job; initialAt = Date.now(); initialState = initial.state;
+    events.push({ at: initialAt, event: 'job.initial_wait.returned_to_C', sessionID: childID, ...initial });
+    observer = (async () => {
+      await wait(50);
+      taskDuring = await parentTask(); events.push({ at: Date.now(), event: 'parent.task.during', task: taskDuring });
+      const incremental = this.read(binding, { job: jobID, stream: 'stdout' });
+      events.push({ at: Date.now(), event: 'host.incremental.read', ...incremental });
+      if (scenario === 'abort') { events.push({ at: Date.now(), event: 'public.session.abort', sessionID: childID }); await client.session.abort({ sessionID: childID }, { throwOnError: true }); }
+      const final = await this.waitSettled(binding, jobID); endedAt = Date.now();
+      events.push({ at: endedAt, event: 'job.settled.observed', sessionID: childID, ...final });
+    })().catch(e => { observedError = String(e); });
+    return initial;
+  };
+  const stub = createServer((req, res) => { void (async () => {
+    const chunks: Buffer[] = []; for await (const chunk of req) chunks.push(Buffer.from(chunk));
+    if (req.method !== 'POST' || !req.url?.endsWith('/chat/completions')) { res.writeHead(404).end('{}'); return; }
+    const body = JSON.parse(Buffer.concat(chunks).toString()) as { messages: Array<{ role: string; content?: unknown }> };
+    const child = JSON.stringify(body.messages.find(m => m.role === 'user')?.content ?? '').includes('LONG_JOB_CHILD');
+    const step = child ? childStep++ : parentStep++;
+    const results = body.messages.filter(m => m.role === 'tool').map(m => String(m.content));
+    const calls: Array<{ name: string; args: object }> = [];
+    if (!child && step === 0) calls.push({ name: 'ctf_challenge_assign', args: { role: 'recon', challenge: 'X' } });
+    if (!child && step === 1) calls.push({ name: 'task', args: { description: 'long job candidate', subagent_type: 'recon', prompt: 'LONG_JOB_CHILD execute one terminal job' } });
+    if (child && step === 0) calls.push({ name: 'ctf_job_run', args: { argv: [process.execPath, '-e', `console.log('early');setTimeout(()=>console.log('late'),${scenario === 'success' ? 16000 : 30000})`], wait_ms: 20, timeout_ms: scenario === 'timeout' ? 250 : 20000, completion: 'terminal' } });
+    if (child && step === 1 && scenario !== 'abort') calls.push({ name: 'ctf_job_read', args: { job: jobID, stream: 'stdout' } });
+    const state = results.some(t => t.includes('"state":"timed_out"')) ? 'timed_out' : results.some(t => t.includes('"state":"exited"')) ? 'exited' : 'unavailable';
+    const content = child ? `FINAL_STATE=${state}; JOB=${jobID}; OUTPUT=${results.join(' ')}` : 'fixture complete';
+    const requestSeq = ++seq; provider.push({ at: Date.now(), seq: requestSeq, child, step, calls, toolResults: results });
+    const base = { id: `chatcmpl-${requestSeq}`, object: 'chat.completion.chunk', created: Math.floor(Date.now() / 1000), model: 'scripted' };
+    res.writeHead(200, { 'content-type': 'text/event-stream' });
+    const delta = calls.length ? { role: 'assistant', tool_calls: calls.map((c, i) => ({ index: i, id: `call_${requestSeq}_${i}`, type: 'function', function: { name: c.name, arguments: JSON.stringify(c.args) } })) } : { role: 'assistant', content };
+    for (const chunk of [{ ...base, choices: [{ index: 0, delta, finish_reason: null }] }, { ...base, choices: [{ index: 0, delta: {}, finish_reason: calls.length ? 'tool_calls' : 'stop' }] }, { ...base, choices: [], usage: { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 } }]) res.write(`data: ${JSON.stringify(chunk)}\n\n`);
+    res.end('data: [DONE]\n\n');
+  })().catch(e => { observedError = String(e); res.end('{}'); }); });
+  await new Promise<void>(r => stub.listen(0, '127.0.0.1', r));
+  const baseURL = `http://127.0.0.1:${(stub.address() as { port: number }).port}/v1`;
+  process.env.GDEC_LONG_JOB_STUB_KEY = 'local-scripted-only';
+  process.env.HTTP_PROXY = process.env.HTTPS_PROXY = process.env.ALL_PROXY = 'http://127.0.0.1:9'; process.env.NO_PROXY = '127.0.0.1,localhost';
+  await writeFile(join(root, 'opencode.json'), JSON.stringify({ model: 'stub/scripted', enabled_providers: ['stub'], provider: { stub: { npm: '@ai-sdk/openai-compatible', options: { baseURL, apiKey: '{env:GDEC_LONG_JOB_STUB_KEY}' }, models: { scripted: { limit: { context: 32768, output: 2048 } } } } } }));
+  await writeFile(join(root, 'challenges.json'), JSON.stringify({ challenges: [{ id: 'X', statement: 'No-model long-job completion probe' }] }));
+  await writeFile(join(root, 'profile.json'), JSON.stringify({ profileId: 'gdec-long-job', opencode: { configPath: 'opencode.json', binaryPath: '/Users/caihaoming/.opencode/bin/opencode' }, challenges: 'challenges.json', reference: { enabled: false }, budget: { wallClockMs: 45000, maxSteps: 15, maxToolJobs: 2, maxObservableTokens: 100000 }, os: { platform: 'macos' } }));
+  try {
+    result = await launch({ profile: join(root, 'profile.json'), runsRoot: join(root, 'runs'), runId: scenario, onStarted: async context => {
+      client = context.client; rootID = context.rootId;
+      const stream = await client.event.subscribe({}, { throwOnError: true, signal: abortEvents.signal });
+      void (async () => { try { for await (const event of stream.stream) {
+        if (event.type === 'message.part.updated') { const part = event.properties.part; if (part.type === 'tool') events.push({ at: Date.now(), event: 'opencode.tool.part', sessionID: part.sessionID, callID: part.callID, tool: part.tool, state: part.state.status, part }); }
+        else if (event.type === 'session.idle') events.push({ at: Date.now(), event: event.type, sessionID: event.properties.sessionID });
+      } } catch { /* stream closed by test cleanup */ } })();
+    } });
+    await observer;
+    assert.equal(observedError, undefined); assert.equal(result.status, 'completed'); assert.equal(initialState, 'running');
+    assert.equal((taskDuring as { state: { status: string } })?.state.status, 'running');
+    const resource = JSON.parse(await readFile(join(result.runDir!, 'evidence/tool-resources.json'), 'utf8')).find((r: { tool: string }) => r.tool === 'job.run');
+    assert.equal(resource.job, jobID); assert.equal(resource.sessionID, childID); assert.equal(resource.state, 'settled');
+    assert.equal(provider.flatMap(r => r.calls as Array<{ name: string }>).filter(c => c.name === 'ctf_job_run').length, 1);
+    const childAfterInitial = provider.filter(r => r.child && Number(r.at) > initialAt);
+    assert(childAfterInitial.every(r => Number(r.at) >= endedAt - 10), 'no child provider request until terminal settlement');
+    const parentMessages = JSON.parse(await readFile(join(result.runDir!, `evidence/messages-${rootID}.json`), 'utf8'));
+    const finalTasks = parentMessages.flatMap((m: { parts: unknown[] }) => m.parts).filter((p: { tool?: string }) => p.tool === 'task');
+    assert.equal(finalTasks.length, 1);
+    const finalTask = finalTasks[0];
+    assert.equal(finalTask.id, (taskDuring as { id: string }).id);
+    assert.equal(finalTask.callID, (taskDuring as { callID: string }).callID);
+    if (scenario !== 'abort') {
+      assert.equal(finalTask.state.status, 'completed'); assert(finalTask.state.output.includes(`FINAL_STATE=${scenario === 'success' ? 'exited' : 'timed_out'}`));
+      assert(finalTask.state.output.includes(jobID));
+      if (scenario === 'success') { assert(endedAt - initialAt > 15000); assert(finalTask.state.output.includes(Buffer.from('early\nlate\n').toString('base64'))); }
+    } else { assert.equal(finalTask.state.status, 'error'); assert.equal(resource.result, 'cancelled'); assert.equal(childAfterInitial.length, 0); }
+  } catch (e) { failure = String(e); process.exitCode = 1; }
+  finally {
+    abortEvents.abort(); JobManager.prototype.run = originalRun;
+    await writeFile(join(out, 'events.json'), JSON.stringify(events, null, 2));
+    await writeFile(join(out, 'provider.json'), JSON.stringify(provider, null, 2));
+    await writeFile(join(out, 'result.json'), JSON.stringify({ result, failure, observedError, root, rootID, childID, jobID, initialAt, endedAt, initialState, realModelCalls: 0, realModelUsage: 'not applicable: loopback deterministic replacement', notifier: 'none; wrappers only observe' }, null, 2));
+    if (result?.runDir) for (const name of await readdir(join(result.runDir, 'evidence'))) {
+      if (/^(control-audit|tool-resources|bindings|admissions|sessions|messages-.*)\.json$/.test(name)) await writeFile(join(out, name), await readFile(join(result.runDir, 'evidence', name)));
+    }
+    await new Promise<void>(r => { stub.close(() => r()); stub.closeAllConnections(); });
+  }
+  console.log(JSON.stringify({ scenario, result, failure, observedError, jobID, initialAt, endedAt }));
+}
