# Copy local secrets into .env. Never commit .env.
# Volcano Ark Anthropic-compatible coding endpoint
ARK_API_KEY=

# Custom Volcano plan gateway: base URL and key both stay local.
VOLCANO_PLAN_BASE_URL=
VOLCANO_PLAN_API_KEY=

# Pay-as-you-go Ark credential for automated runs. Do not use the Coding Plan key here.
ARK_API_KEY_PAYG=

# DeepSeek official API (https://api.deepseek.com)
DEEPSEEK_API_KEY=
