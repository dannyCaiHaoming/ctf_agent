{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profileId", "opencode", "reference", "budget", "os"],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "solverMode": { "enum": ["m1"] },
    "opencode": {
      "type": "object", "required": ["configPath"], "additionalProperties": false,
      "properties": { "configPath": { "type": "string", "minLength": 1 }, "binaryPath": { "type": "string", "minLength": 1 } }
    },
    "challenges": { "type": "string", "minLength": 1 },
    "solverProfile": {
      "type": "object",
      "required": ["promptTemplateVersion", "toolManifestVersion"],
      "properties": {
        "promptTemplateVersion": { "type": "string", "minLength": 1 },
        "toolManifestVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reference": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": false },
    "budget": {
      "type": "object",
      "required": ["wallClockMs", "maxSteps", "maxToolJobs", "maxObservableTokens"],
      "properties": {
        "wallClockMs": { "type": "integer", "minimum": 1 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxToolJobs": { "type": "integer", "minimum": 1 },
        "maxObservableTokens": { "type": "integer", "minimum": 1 },
        "reconMaxModelCalls": { "type": "integer", "minimum": 2, "description": "Optional total recon model-call bound B per run/challenge, including closure. Runtime validation also requires R<B." },
        "reconClosureReserve": { "type": "integer", "minimum": 1, "description": "Optional closure reserve R within B; 0<R<B, validated by loadReleaseProfile." }
      },
      "dependentRequired": { "reconMaxModelCalls": ["reconClosureReserve"], "reconClosureReserve": ["reconMaxModelCalls"] },
      "additionalProperties": false
    },
    "os": { "type": "object", "required": ["platform"], "properties": { "platform": { "enum": ["macos", "linux"] } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
