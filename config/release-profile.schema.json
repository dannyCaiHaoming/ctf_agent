{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profileId", "reference", "budget", "os"],
  "oneOf": [{ "required": ["model"], "not": { "required": ["opencode"] } }, { "required": ["opencode"], "not": { "required": ["model"] } }],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "solverMode": { "enum": ["m0", "m1"] },
    "opencode": {
      "type": "object", "required": ["configPath"], "additionalProperties": false,
      "properties": { "configPath": { "type": "string", "minLength": 1 }, "binaryPath": { "type": "string", "minLength": 1 } }
    },
    "solverProfile": {
      "type": "object",
      "required": ["promptTemplateVersion", "toolManifestVersion"],
      "properties": {
        "promptTemplateVersion": { "type": "string", "minLength": 1 },
        "toolManifestVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "apiKeyEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "responseFormat": { "enum": ["json_object", "prompt_only"] }
      },
      "additionalProperties": false
    },
    "reference": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } }, "additionalProperties": false },
    "budget": {
      "type": "object",
      "required": ["wallClockMs", "maxSteps", "maxToolJobs", "maxObservableTokens"],
      "properties": {
        "wallClockMs": { "type": "integer", "minimum": 1 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxToolJobs": { "type": "integer", "minimum": 1 },
        "maxObservableTokens": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "os": { "type": "object", "required": ["platform"], "properties": { "platform": { "enum": ["macos", "linux"] } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
