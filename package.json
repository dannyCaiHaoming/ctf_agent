{
  "name": "ctf-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:deterministic": "vitest run tests/bootstrap tests/contract",
    "test": "vitest run",
    "gate:m0": "vitest run tests/bootstrap tests/contract tests/gates/m0.gate.ts tests/integration/opencode-solve.test.ts",
    "gate:m1": "vitest run tests/gates/m1.gate.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "target:start": "tsx fixtures/local-target/src/server.ts 8787"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "@opencode-ai/sdk": "1.19.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
